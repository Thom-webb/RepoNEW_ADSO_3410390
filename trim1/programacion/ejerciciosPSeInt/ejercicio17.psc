Proceso ejercicio17
	//Thomas toro cuervo
	//Pedir dos números y decir si son iguales o no
	
	Definir A como real;
	Definir B como real;
	
	Escribir "digita el numero A";
	Leer A;
	
	Escribir "digite el numero B";
	Leer B;
	
	si(A=B)entonces
		escribir "tus numeros son iguales";
	SiNo
		Escribir "tus numeros son diferentes";
	FinSi
FinProceso
