Proceso ejercicio27
	//Thomas toro cuervo
	//Pedir un número y decir si es par o impar.
	
	Definir A como entero;
	
	Escribir "digita tu numero entero para saber si es par o impar";
	leer A;
	
	Si(A%2==0)Entonces
		Escribir "tu numero es par";
	SiNo
		Escribir "tu numero es impar";
	FinSi
	
FinProceso
