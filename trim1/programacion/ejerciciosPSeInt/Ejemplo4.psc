Proceso Ejemplo4
	//Thomas toro 
	//solicitar al usuario 3 numeros y mostrar en pantalla el promedio de todos 
	
	Definir A como entero;
	Definir B como entero;
	definir C como entero;
	definir promedio como real;
	
	Escribir "digite los 3 numero";
	Leer A , B , C;
	
	
	//Proceso
	promedio <- (A+B+C)/3;
	//SALIDA
	Escribir "El promedio de los numeros: " ,A, ", " ,B, " Y " ,C, " es: " ,promedio, ;
	
FinProceso
