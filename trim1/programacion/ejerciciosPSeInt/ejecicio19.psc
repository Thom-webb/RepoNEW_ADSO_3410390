Proceso ejecicio19
	//thomas toro cuervo
	//Pedir dos números y decir si uno es múltiplo del otro.
	
	Definir A,B como real;
	
	Escribir "digita A y B";
	Leer A,B;
	
	si(A%B==0)Entonces
		Escribir "tu numero es multiplo del otro";
	SiNo
		Escribir "tu numero no es multiplo del otro";
	FinSi
	
FinProceso
