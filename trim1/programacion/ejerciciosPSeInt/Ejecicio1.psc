Algoritmo Ejecicio1
	//Thomas toro cuervo 
	//Hacer un algoritmo que declare una variable para guardar el número de horas de estudio, y otra para
	//guardar el nombre. Escribir ambos datos
	
	Definir numero_horas Como Real;
	Definir nombre Como Cadena;
	
	Escribir "Ingrese el numero de horas";
	Leer numero_horas;
	
	Escribir "Ingrese el nombre";
	Leer nombre;
	
	Escribir nombre," su numero de horas es :",numero_horas;
	
FinAlgoritmo
