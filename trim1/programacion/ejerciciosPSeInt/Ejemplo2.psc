	//inicializacion de variables 
	cantAprendices <- 30;
	promedioEstatura <- 1.65;
	programaFormacion <- "Analisis y desarrollo de software";
	
	// SALIDA DE Algoritmo 
	Escribir "La cantidad de aprendices es:",cantAprendices;
	Escribir "El promedio de estatura es: ",promedioEstatura;
	Escribir "El programa de formacion es: ",programaFormacion;
	
	
	
	

