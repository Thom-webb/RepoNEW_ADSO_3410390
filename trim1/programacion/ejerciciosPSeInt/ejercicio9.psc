Proceso ejercicio9
	//Thomas toro cuervo
	//Hacer un algoritmo que lea el nombre de un estudiante, la cantidad de materias perdidas y la cantidad
	//de materias ganadas.
	
	Definir nombre como cadena;
	Definir materias_perdidas como entero;
	Definir materias_ganadas como entero;
	
	Escribir "cual es tu nombre?";
	leer nombre;
	
	Escribir "cuantas materias reprobadas tienes?";
	leer materias_perdidas;
	
	Escribir "y cuantas materias tienes aprobadas?";
	leer materias_ganadas;
	
	
FinProceso
